[Unit]
Description=obdaAI owner-confirmed source network leases
After=docker.service obdaai-egress.service
Requires=docker.service
[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/lib/obdaai/source-network.py
ExecStopPost=/usr/bin/python3 /usr/local/lib/obdaai/source-network.py --clear
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
[Install]
WantedBy=multi-user.target

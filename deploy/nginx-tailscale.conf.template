# Loopback backend for private HTTPS via Tailscale Serve.
# Install alongside the existing private-IP vhost; nginx.conf includes this at http scope.
# Preserve unrecognized/missing Origins so the application's CSRF check still rejects them.
map $http_origin $obdaai_tailscale_origin {
    default $http_origin;
    "https://__TAILSCALE_HOST__" "https://__PRIVATE_IP__";
}
server {
    listen 127.0.0.1:8777;
    server_name __TAILSCALE_HOST__;
    server_tokens off;
    access_log off;
    error_log /var/log/nginx/obdaai-error.log warn;
    client_max_body_size 1m;
    # Only tailscaled on this host may reach this loopback listener.
    allow 127.0.0.1;
    deny all;
    if ($host != "__TAILSCALE_HOST__") { return 444; }
    location ~ "^/api/projects/[0-9a-fA-F-]{36}/sources$" {
        # Raw document uploads match the bounded 40 MiB application limit.
        client_max_body_size 40m;
        proxy_pass http://127.0.0.1:8766;
        proxy_http_version 1.1;
        proxy_set_header Host __PRIVATE_IP__;
        proxy_set_header Origin $obdaai_tailscale_origin;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 600s;
        proxy_next_upstream off;
    }
    location = /api/skills/import-package {
        client_max_body_size 20m;
        proxy_pass http://127.0.0.1:8766;
        proxy_http_version 1.1;
        proxy_set_header Host __PRIVATE_IP__;
        proxy_set_header Origin $obdaai_tailscale_origin;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 600s;
        proxy_next_upstream off;
    }
    location / {
        proxy_pass http://127.0.0.1:8766;
        proxy_http_version 1.1;
        proxy_set_header Host __PRIVATE_IP__;
        proxy_set_header Origin $obdaai_tailscale_origin;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 600s;
        proxy_next_upstream off;
    }
}

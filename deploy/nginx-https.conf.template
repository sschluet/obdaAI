# Replace reviewed private address. Install only on the dedicated VM.
server {
    listen __PRIVATE_IP__:443 ssl;
    server_name __PRIVATE_IP__;
    ssl_certificate /etc/obdaai/tls/server.crt;
    ssl_certificate_key /etc/obdaai/tls/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    server_tokens off;
    access_log off;
    error_log /var/log/nginx/obdaai-error.log warn;
    client_max_body_size 1m;
    # A mismatched Host must not reach the API.
    if ($host != "__PRIVATE_IP__") { return 444; }
    location / {
        proxy_pass http://127.0.0.1:8766;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 180s;
        proxy_next_upstream off;
    }
}

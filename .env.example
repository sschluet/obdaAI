# Synthetic defaults for isolated development; do not deploy these credentials.
HUB_DATABASE_URL=postgresql+psycopg://hub:change-me@db:5432/hub
HUB_ORIGIN=http://127.0.0.1:8765
HUB_SECURE_COOKIE=true
HUB_PASSWORD_HASH=
HUB_LOCAL_BASE_URL=
HUB_LOCAL_MODEL=
HUB_LOCAL_KEY_FILE=
HUB_LOCAL_ALLOWED_IP=
# Only enable when verified for the selected local backend.
HUB_LOCAL_DISABLE_THINKING=false
HUB_OPENROUTER_MODEL=
HUB_OPENROUTER_KEY_FILE=
HUB_CLOUD_ENABLED=false
# Private base64 file containing 32 random bytes; generated outside the database.
HUB_SECRETS_KEY_FILE=
# Server-approved additional local Base URLs and their exact private IPs.
HUB_LOCAL_ENDPOINTS_JSON={}
# Routing and preparation budget; answer generation has a separate wall-clock limit.
HUB_RUN_TIMEOUT=90
# Generation: seconds after preparation, inclusive of all streamed output (30..900).
HUB_GENERATION_TIMEOUT=600
HUB_STATIC_DIR=frontend/dist

# Exact operator-approved public URL/IP/name per target. Default: no browser targets.
HUB_BROWSER_TARGETS_JSON={}
HUB_BROWSER_REQUEST_DIR=
HUB_BROWSER_RESULT_DIR=
# Exact approved MCP endpoint/IP and empty-input read-tool schema digests.
HUB_MCP_ENDPOINTS_JSON={}
HUB_MCP_READ_TOOLS_JSON={}

# Operator enables configured integration targets; paired with own VM egress observer.
HUB_INTEGRATION_TARGETS_ENABLED=false
# Calendar context for relative dates in local system/mail requests (IANA zone).
HUB_AGENT_TIMEZONE=Europe/Berlin

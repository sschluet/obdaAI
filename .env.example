# Synthetic defaults for isolated development; do not deploy these credentials.
HUB_DATABASE_URL=postgresql+psycopg://hub:change-me@db:5432/hub
HUB_ORIGIN=http://127.0.0.1:8765
HUB_SECURE_COOKIE=true
HUB_PASSWORD_HASH=
HUB_LOCAL_BASE_URL=
HUB_LOCAL_MODEL=
HUB_LOCAL_KEY_FILE=
HUB_LOCAL_ALLOWED_IP=
# Only enable when verified for the selected local backend.
HUB_LOCAL_DISABLE_THINKING=false
HUB_OPENROUTER_MODEL=
HUB_OPENROUTER_KEY_FILE=
HUB_CLOUD_ENABLED=false
HUB_STATIC_DIR=frontend/dist
